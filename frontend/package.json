{
  "name": "workspace-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../docs/api/openapi.yaml -o src/types/api.ts",
    "check:api": "openapi-typescript ../docs/api/openapi.yaml -o src/types/api.check.ts && diff -q src/types/api.check.ts src/types/api.ts; r=$?; rm -f src/types/api.check.ts; exit $r",
    "format": "prettier --write src",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "diff": "9.0.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/diff": "8.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
